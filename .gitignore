# Release packing ephemerals (release.yml packs into .pack/)
*.tgz
.pack/

# actionlint binary fetched by infrastructure/scripts/ensure-actionlint.sh
/actionlint

# preflight skill scratch output (written at the repo root on each run)
.preflight-summary.json

# Per-skill config.json is generated, not tracked (R-615): `skills add --copy`
# vendors every tracked file under skills/<name>/, so a tracked config.json would
# leak this repo's own values into consumers. The neutral config.example.json is
# the only config that ships; this repo's real values live in the tracked
# infrastructure/dogfood-config/ tree and are materialised by `pnpm bootstrap:config`.
skills/*/config.json

node_modules/
dist/
build/
coverage/

.turbo/

.DS_Store
*.log
.npm/
.pnpm-store/

.env
.env.local
.env.*.local

.idea/
.vscode/
*.swp
*.swo

# Claude Code local/runtime artifacts
.claude/scheduled_tasks.lock
.claude/worktrees/
.claude/settings.local.json

# Dogfood-only (R-616): a manual `initialise-skills --write` against THIS repo emits
# a consumer lock at .claude/skills.lock. The source repo IS the source of truth, so
# its own lock is noise — consumers commit theirs; this repo ignores it.
.claude/skills.lock

# ESLint cache
.eslintcache
